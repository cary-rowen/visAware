#: addon\globalPlugins\visAware\askDialog.py:60
msgid "Conversation &history:"
msgstr "Історія &розмови:"

#. Translators: The label for the follow-up question edit field.
#: addon\globalPlugins\visAware\askDialog.py:78
msgid "&Question:"
msgstr "&Питання:"

#. Translators: The label for a button that sends a follow-up question.
#: addon\globalPlugins\visAware\askDialog.py:92
msgid "&Send"
msgstr "&Надіслати"

#. Translators: The label for a button that opens the latest content rendered as Markdown.
#: addon\globalPlugins\visAware\askDialog.py:95
msgid "View &formatted content"
msgstr "Переглянути &відформатований вміст"

#. Translators: The label for a button that closes the follow-up question dialog.
#: addon\globalPlugins\visAware\askDialog.py:98
msgid "&Close"
msgstr "&Закрити"

#. Translators: The sender label for the original image description in the follow-up dialog.
#. Translators: The title of the Image Describer engine settings panel.
#. Translators: A choice meaning automatic recognition should use image description engines.
#: addon\globalPlugins\visAware\askDialog.py:128
#: addon\globalPlugins\visAware\recogHandler.py:42
#: addon\globalPlugins\visAware\recogHandler.py:974
#: addon\globalPlugins\visAware\recogHandler.py:1003
msgid "Image description"
msgstr "Опис зображення"

#. Translators: The sender label for the user in the follow-up dialog.
#: addon\globalPlugins\visAware\askDialog.py:132
#: addon\globalPlugins\visAware\askDialog.py:175
msgid "You"
msgstr "Ви"

#. Translators: Reported while a follow-up question is still being answered.
#. Translators: Reported while a follow-up question is being answered.
#: addon\globalPlugins\visAware\askDialog.py:164
#: addon\globalPlugins\visAware\askDialog.py:182
msgid "Waiting for answer."
msgstr "Чекаю на відповідь."

#. Translators: Reported when the user tries to send an empty follow-up question.
#: addon\globalPlugins\visAware\askDialog.py:170
msgid "Enter a question."
msgstr "Введіть питання."

#. Translators: Reported when a follow-up question fails unexpectedly.
#: addon\globalPlugins\visAware\askDialog.py:226
msgid "Question failed with an unexpected error."
msgstr "Виконання запиту завершилося невдачею через несподівану помилку."

#. Translators: The sender label for an error shown in the follow-up dialog.
#: addon\globalPlugins\visAware\askDialog.py:316
#: addon\globalPlugins\visAware\askDialog.py:324
msgid "Error"
msgstr "Помилка"

#. Translators: Reported when there is no follow-up content to show in rendered form.
#: addon\globalPlugins\visAware\askDialog.py:354
msgid "There is no content to show."
msgstr "Немає вмісту для показу."

#: addon\globalPlugins\visAware\askDialog.py:359
msgid "Formatted Content"
msgstr "Форматований вміст"

#. Translators: Reported when the previous recognition engine cannot answer follow-up questions.
#: addon\globalPlugins\visAware\conversation.py:85
msgid "The previous recognition engine does not support follow-up questions."
msgstr "Сервіс попереднього розпізнавання не підтримує додаткові питання."

#. Translators: Reported when the saved recognition result cannot be reused for follow-up questions.
#: addon\globalPlugins\visAware\conversation.py:89
msgid "The previous recognition result cannot be used for follow-up questions."
msgstr ""
"Результат попереднього розпізнавання не можна використовувати для додаткових "
"питань."

#. Translators: Reported when the saved recognition result cannot be converted to text.
#: addon\globalPlugins\visAware\conversation.py:98
msgid "The previous recognition result cannot be converted to text."
msgstr "Попередній результат розпізнавання неможливо перетворити на текст."

#. Translators: Reported when there is no text in the previous result to use as conversation context.
#: addon\globalPlugins\visAware\conversation.py:101
msgid "The previous recognition result is blank."
msgstr "Попередній результат розпізнавання порожній."


#: addon\globalPlugins\visAware\abstractEngine.py:1028
#: addon\globalPlugins\visAware\abstractEngine.py:1168
#: addon\globalPlugins\visAware\abstractEngine.py:1286
msgid "Engine Error"
msgstr "Помилка сервісу"

#. Translators: A warning shown when trying to disable every engine in a category.
#: addon\globalPlugins\visAware\abstractEngine.py:1091
msgid "At least one engine must remain enabled."
msgstr "Принаймні один сервіс повинен залишатися ввімкненим."

#. Translators: The title of a warning shown for invalid engine enablement settings.
#: addon\globalPlugins\visAware\abstractEngine.py:1093
#: addon\globalPlugins\visAware\abstractEngine.py:1113
#: addon\globalPlugins\visAware\abstractEngine.py:1135
msgid "Engine Configuration"
msgstr "Конфігурація сервісу"

#: addon\globalPlugins\visAware\abstractEngine.py:1107
#, python-brace-format
msgid ""
"The selected engine {engine} is disabled. Please choose another enabled "
"engine, or re-enable it."
msgstr ""
"Вибраний сервіс {engine} вимкнено. Будь ласка, виберіть інший увімкнений "
"сервіс або знову увімкніть його."

#: addon\globalPlugins\visAware\abstractEngine.py:1129
#, python-brace-format
msgid ""
"The current engine {engine} is disabled. Please choose another enabled "
"engine, or re-enable it."
msgstr ""
"Поточний сервіс {engine} вимкнено. Будь ласка, виберіть інший увімкнений "
"сервіс або знову увімкніть його."

#. Translators: The title of the engine selection dialog.
#: addon\globalPlugins\visAware\abstractEngine.py:1192
msgid "Select Engine"
msgstr "Виберіть сервіс"

#. Translators: The label for the choice control to select an engine.
#: addon\globalPlugins\visAware\abstractEngine.py:1229
msgid "&Engines:"
msgstr "&Сервіси:"

#. Translators: A disabled engine option in the engine selection dialog.
#: addon\globalPlugins\visAware\abstractEngine.py:1270
#, python-brace-format
msgid "{engine} (disabled)"
msgstr "{engine} (вимкнено)"

#. Translators: An enabled engine option in the engine selection dialog.
#: addon\globalPlugins\visAware\abstractEngine.py:1272
#, python-brace-format
msgid "{engine} (enabled)"
msgstr "{engine} (увімкнено)"

#. Translators: The title of the follow-up question dialog.
#: addon\globalPlugins\visAware\askDialog.py:36
#: addon\globalPlugins\visAware\askDialog.py:122
#: addon\globalPlugins\visAware\askDialog.py:124
msgid "Ask a Follow-up Question"
msgstr "Задати додаткове питання"


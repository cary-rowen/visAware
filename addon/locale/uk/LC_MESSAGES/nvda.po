#. Translators: An error message for invalid data returned by Kimi.
#: addon\globalPlugins\visAware\kimiAPI.py:23
msgid "Kimi returned an invalid response."
msgstr "Kimi повернув недійсну відповідь."

#. Translators: An error message for malformed Kimi Chat Completion data.
#: addon\globalPlugins\visAware\kimiAPI.py:25
msgid "Kimi returned malformed completion data."
msgstr "Kimi повернув некоректно сформовані дані завершення чату."

#. Translators: An error message for malformed data in a Kimi streaming response.
#: addon\globalPlugins\visAware\kimiAPI.py:27
msgid "Kimi streaming response contained malformed data."
msgstr "Потокова відповідь Kimi містила некоректно сформовані дані."

#. Translators: A fallback message when a Kimi API error has no details.
#: addon\globalPlugins\visAware\kimiAPI.py:52
msgid "Unknown API error"
msgstr "Невідома помилка API"

#. Translators: An error returned by Kimi. The placeholder contains the API's message.
#. Translators: An error message returned from the Kimi API.
#: addon\globalPlugins\visAware\kimiAPI.py:66
#: addon\globalPlugins\visAware\kimiAPI.py:173
#: addon\globalPlugins\visAware\agent\kimi.py:213
#, python-brace-format
msgid "Kimi API error: {}"
msgstr "Помилка API Kimi: {}"

#. Translators: Reported when Kimi stops because the output token limit was reached.
#: addon\globalPlugins\visAware\kimiAPI.py:74
#: addon\globalPlugins\visAware\kimiAPI.py:310
msgid "Kimi response was truncated at the token limit."
msgstr "Відповідь Kimi була обрізана через обмеження кількості токенів."

#. Translators: An error for an unsupported Kimi completion finish reason.
#: addon\globalPlugins\visAware\kimiAPI.py:77
#: addon\globalPlugins\visAware\kimiAPI.py:313
msgid "Kimi returned an unsupported completion result."
msgstr "Kimi повернув непідтримуваний результат завершення."

#. Translators: Reported when a Kimi stream ends without its completion marker.
#: addon\globalPlugins\visAware\kimiAPI.py:304
msgid "Kimi streaming response ended before completion."
msgstr "Потокова відповідь Kimi завершилася передчасно."

#. Translators: Reported when a Kimi stream does not provide a finish reason.
#: addon\globalPlugins\visAware\kimiAPI.py:307
msgid "Kimi streaming response did not include a finish reason."
msgstr "Потокова відповідь Kimi не містила причини завершення."

#. Translators: Reported when a Kimi stream claims to call a tool but supplies none.
#: addon\globalPlugins\visAware\kimiAPI.py:317
msgid "Kimi streaming response contained no tool call."
msgstr "Потокова відповідь Kimi не містила виклику інструменту."

#. Translators: Reported when a Kimi stream unexpectedly includes a tool call.
#: addon\globalPlugins\visAware\kimiAPI.py:321
msgid "Kimi streaming response returned an unexpected tool call."
msgstr "Потокова відповідь Kimi містила неочікуваний виклик інструменту."


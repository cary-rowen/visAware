#. Translators: The title of the engine-specific settings panel.
#: addon\globalPlugins\visAware\abstractEngine.py:514
msgid "Engine settings"
msgstr "Налаштування сервісу"

#. Translators: The default title for an engine settings panel.
#: addon\globalPlugins\visAware\abstractEngine.py:909
msgid "Engine"
msgstr "Сервіс"

#. Translators: The label for the group box to select an engine.
#: addon\globalPlugins\visAware\abstractEngine.py:928
msgid "Engines"
msgstr "Сервіс"

#. Translators: The label for a button to change the current engine.
#: addon\globalPlugins\visAware\abstractEngine.py:944
msgid "C&hange..."
msgstr "З&мінити..."

#. Translators: The label for a checkbox that enables or disables the selected engine.
#: addon\globalPlugins\visAware\abstractEngine.py:951
msgid "&Enable this engine"
msgstr "&Увімкнути цей сервіс"

#: addon\globalPlugins\visAware\abstractEngine.py:1026
#: addon\globalPlugins\visAware\abstractEngine.py:1166
#: addon\globalPlugins\visAware\abstractEngine.py:1284
#, python-format
msgid "Could not load the %s engine."
msgstr "Не вдалося завантажити сервіс %s."


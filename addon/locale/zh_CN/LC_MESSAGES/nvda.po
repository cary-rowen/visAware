msgstr "Kimi API 错误：{}"

#. Translators: Reported when Kimi stops because the output token limit was reached.
#: addon\globalPlugins\visAware\kimiAPI.py:74
#: addon\globalPlugins\visAware\kimiAPI.py:310
msgid "Kimi response was truncated at the token limit."
msgstr "Kimi 响应因达到 token 上限而被截断。"

